# ===== Backend (Spring Boot) =====
# SERVER_PORT=
# SPRING_PROFILES_ACTIVE=

# ===== Database (PostgreSQL) =====
# DB_HOST=
# DB_PORT=
# DB_NAME=
# DB_USERNAME=
# DB_PASSWORD=

# ===== Database (Docker Compose - local PostgreSQL container) =====
# POSTGRES_DB=queueflow
# POSTGRES_USER=queueflow
# POSTGRES_PASSWORD=changeme

# ===== Security / JWT =====
# Required by the backend: Base64-encoded key of at least 32 bytes. Generate
# your own (e.g. `openssl rand -base64 32`) and never commit it. Tokens last
# 1 hour (queueflow.security.jwt.ttl in application.yml).
# JWT_SECRET=<base64-encoded-random-32-bytes>


# ===== Frontend (React + Vite) =====
# Backend origin (no trailing /api). Read by the frontend from this root
# .env (vite.config.ts envDir); only VITE_* variables reach the browser.
# VITE_API_BASE_URL=http://localhost:8080
